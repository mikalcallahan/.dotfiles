## App rules
yabai -m rule --add app="Finder$" manage=off
yabai -m rule --add app="^(iTerm2|VSCodium)$" space=code 
yabai -m rule --add app="^(Safari|Firefox Developer Edition|Firefox|Brave Browser)$" space=web
yabai -m rule --add app="^(Maps|Music|News)$" space=media 
yabai -m rule --add app="^(Notes|Reminders|ChatGPT)$" space=notes
yabai -m rule --add app="^(Discord|Messages|Signal|Slack|X)$" space=social
yabai -m rule --add app="^(Simulator|Xcode)" manage=on
yabai -m rule --add app="^(Activity Monitor|App Store|Archive Utility|Bitwarden|Calculator|Calendar|Coinbase|Dictionary|LuLu|Mail|Photo Booth|Preview|Python|Screen Sharing|Software Update|Steam|VLC)$" manage=off
yabai -m rule --add subrole="^(AXDialog|AXSystemDialog|AXFloatingWindow|AXSystemFloatingWindow)$" manage=off
yabai -m rule --add app="^Obsidian$" title="^(Settings|Preferences)$" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advanced)$" manage=off
yabai -m rule --add app="wine64-preloader" manage=off
