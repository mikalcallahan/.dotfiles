#!/bin/sh

if [ -z "${TMUX_PANE:-}" ] || ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

terminal_is_frontmost() {
  [ "$(uname -s)" = "Darwin" ] || return 1

  frontmost_bundle=$(osascript -l JavaScript \
    -e 'ObjC.import("AppKit"); $.NSWorkspace.sharedWorkspace.frontmostApplication.bundleIdentifier.js' \
    2>/dev/null) || return 1
  [ -n "$frontmost_bundle" ] || return 1

  for client_pid in $(tmux list-clients -F '#{client_pid}'); do
    client_environment=$(ps eww -p "$client_pid" -o command= 2>/dev/null)
    case " $client_environment " in
      *" __CFBundleIdentifier=$frontmost_bundle "*) return 0 ;;
    esac
  done
  return 1
}

notify_completion() {
  agent=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_command}')
  directory=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_path}')
  case "$directory" in
    "$HOME") directory="~" ;;
    "$HOME"/*) directory="~${directory#"$HOME"}" ;;
  esac
  case "$agent" in
    opencode) agent="OpenCode" ;;
    codex) agent="Codex" ;;
    claude) agent="Claude" ;;
  esac

  osascript - "$agent finished · $directory" "${1:-Response completed}" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
}

case "${1:-}" in
  clear)
    tmux set-option -p -t "$TMUX_PANE" @ai_unread 0
    ;;
  complete)
    visible_clients=$(tmux list-clients -f "#{==:#{pane_id},$TMUX_PANE}" -F '#{client_name}')
    if [ -n "$visible_clients" ]; then
      tmux set-option -p -t "$TMUX_PANE" @ai_unread 0
    else
      tmux set-option -p -t "$TMUX_PANE" @ai_unread 1
    fi
    terminal_is_frontmost || notify_completion "${2:-}"
    ;;
esac
