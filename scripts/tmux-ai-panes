#!/bin/sh

panes=$(tmux list-panes -a -F '#{pane_id}	#{session_name}	#{window_index}:#{window_name}	#{pane_current_command}	#{pane_current_path}	#{?#{==:#{@ai_unread},1},●,}')
ai_panes=""

while IFS="	" read -r pane session window command path unread; do
  case "$command" in
    opencode|codex|claude)
      ai_panes="${ai_panes}${pane}	${session}	${window}	${command}	${path}	${unread}
"
      ;;
  esac
done <<EOF
$panes
EOF

if [ -z "$ai_panes" ]; then
  tmux display-message "No AI panes"
  exit 0
fi

selection=$(printf '%s' "$ai_panes" | fzf \
  --delimiter='\t' \
  --with-nth=2.. \
  --layout=reverse \
  --border \
  --header='session  window  agent  path  unread' \
  --prompt='AI pane > ')
[ -n "$selection" ] || exit 0

pane=${selection%%	*}
session=$(tmux display-message -p -t "$pane" '#{session_id}')
window=$(tmux display-message -p -t "$pane" '#{window_id}')

tmux select-window -t "$window"
tmux select-pane -t "$pane"
tmux switch-client -t "$session"
